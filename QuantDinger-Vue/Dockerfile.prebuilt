# TradeLens Frontend — prebuilt static bundle
#
# Use this Dockerfile when you have ALREADY built the frontend locally
# (e.g., pnpm build on your dev machine) and want to package the dist/
# folder into an nginx image on the server WITHOUT running Node/pnpm.
#
# Build command (run on server, after uploading dist/):
#   docker build -f Dockerfile.prebuilt -t tradelens-frontend .
#
# Or simply use docker-compose.prebuilt.yml which mounts dist/ as a volume
# and skips image building entirely — that is faster for most cases.

ARG NGINX_IMAGE=nginx:1.25-alpine

FROM ${NGINX_IMAGE}

RUN apk add --no-cache curl

ENV NGINX_ENVSUBST_FILTER=BACKEND_URL \
    BACKEND_URL=http://backend:5000

COPY deploy/nginx-docker.conf.template /etc/nginx/templates/default.conf.template
COPY dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
